# Read by docker-compose (repo root). Set real values in .env, never commit them.
# All secrets must be hex (URL-safe); generate one in PowerShell with:
#   $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })

# Vault dev-mode root token (used only by vault-init) and the scoped app token id.
# The app's VAULT_TOKEN in frontend/.env.local must equal VAULT_APP_TOKEN.
VAULT_DEV_TOKEN=
VAULT_APP_TOKEN=

# MongoDB root user (admin only) and the app user (readWrite on kyc_studio).
# These apply only to an EMPTY data volume: run `docker compose down -v` once before the first `up` with auth.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=
MONGO_APP_PASSWORD=
