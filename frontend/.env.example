MODEL_API_KEY=
VAULT_ADDR=
VAULT_TOKEN=
MONGODB_URI=
AI_PROVIDER=mock
# Shared code that unlocks API routes calling AI providers or changing policies.
# Required: with it unset those routes refuse every request.
DEMO_ACCESS_CODE=
# Requests per minute per client IP on guarded routes (default 30).
RATE_LIMIT_PER_MINUTE=30
# Provider calls per UTC day across all routes, mock included (default 500).
AI_DAILY_CALL_CAP=500
