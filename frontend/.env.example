MODEL_API_KEY=
# Vault (docker compose): http://127.0.0.1:8200 and the scoped app token, i.e. the
# same value as VAULT_APP_TOKEN in the root .env, never the root dev token.
VAULT_ADDR=
VAULT_TOKEN=
# mongodb://<MONGO_APP_USER>:<MONGO_APP_PASSWORD>@127.0.0.1:27017/kyc_studio?authSource=kyc_studio
# Use hex passwords so the URI needs no escaping (generator in docs/persistence.md).
MONGODB_URI=
AI_PROVIDER=mock
# Shared code that unlocks API routes calling AI providers or changing policies.
# Required: with it unset those routes refuse every request.
DEMO_ACCESS_CODE=
# Requests per minute per client IP on guarded routes (default 30).
RATE_LIMIT_PER_MINUTE=30
# Provider calls per UTC day across all routes, mock included (default 500).
AI_DAILY_CALL_CAP=500
# Meta reasoning effort per step: minimal|low|medium|high|xhigh|max ("none" is rejected by Muse Spark).
# Defaults: low for every step.
META_EFFORT_CLASSIFY=
META_EFFORT_EXTRACT=
META_EFFORT_OTHER=
# Policy compiler and customer guide (Meta mode). Same values as above.
# Defaults: low for both.
META_EFFORT_COMPILE=
META_EFFORT_GUIDE=
# Output cap for the customer guide call (default 6000; 2000 was cut off at low effort).
META_MAX_TOKENS_GUIDE=
# Storage backends: file (default) or mongo. See docs/persistence.md for valid combinations.
POLICY_STORE=file
APPLICATION_LOG=file
# AI call log: file (memory + data/ai-calls.jsonl), memory or mongo (ai_calls).
AI_CALL_LOG=file
# Second secret for destructive actions (delete customer, retention purge, seed reset).
# Must differ from DEMO_ACCESS_CODE; unset means those actions are refused.
ADMIN_ACCESS_CODE=
# Audit log: console (default, no chain), memory (chain, lost on restart) or mongo (audit_events).
AUDIT_LOG=console
