# Production configuration for docker-compose.prod.yml. Two files, both next to
# docker-compose.prod.yml, both gitignored and never copied into the image:
#
#   .env      read by docker compose for the ${...} values in the compose file
#   .env.app  passed to the app container as its environment
#
# Create them from the two sections below, then restrict them to your user:
#
#   chmod 600 .env .env.app
#
# Secrets: hex only (no characters that need escaping in a MongoDB URI), e.g.
#   openssl rand -hex 24
# Never reuse a value for two variables.

# =====================================================================
# File 1: .env  (compose interpolation)
# =====================================================================

# Public host name Caddy serves and gets a certificate for. Its DNS A/AAAA
# record must point at this server, and ports 80 and 443 must be open.
SITE_DOMAIN=kyc.example.com

# Vault dev-mode root token. Used only by vault-init, never by the app.
VAULT_DEV_TOKEN=
# Id of the scoped app token that vault-init creates (hex only). The app gets it as VAULT_TOKEN.
VAULT_APP_TOKEN=

# MongoDB admin, used only by the mongo container's first-start init.
MONGO_ROOT_USER=kycroot
MONGO_ROOT_PASSWORD=
# The app's MongoDB user (readWrite on kyc_studio only). The compose file builds
# MONGODB_URI from these two.
MONGO_APP_USER=kycapp
MONGO_APP_PASSWORD=

# =====================================================================
# File 2: .env.app  (app container environment)
# =====================================================================
# Set by docker-compose.prod.yml and ignored if put here: NODE_ENV, POLICY_STORE,
# AI_CALL_LOG, AUDIT_LOG, APPLICATION_LOG, MONGODB_URI, VAULT_ADDR, VAULT_TOKEN.

# mock (no model calls) or meta.
AI_PROVIDER=mock
# Meta API key; required when AI_PROVIDER=meta.
MODEL_API_KEY=
# Optional model override (default muse-spark-1.3).
META_MODEL=

# Shared code that unlocks routes calling AI or changing policies. Required:
# with it unset those routes refuse every request.
DEMO_ACCESS_CODE=
# Second secret for destructive admin actions. Must differ from DEMO_ACCESS_CODE;
# unset means those actions are refused.
ADMIN_ACCESS_CODE=

# Requests per minute per client IP on guarded routes (default 30). The client
# IP is the one Caddy saw (it replaces any client-supplied X-Forwarded-For).
RATE_LIMIT_PER_MINUTE=30
# AI calls per UTC day (default 500). Restored from ai_calls on restart.
AI_DAILY_CALL_CAP=500

# Optional Meta tuning (defaults: low effort everywhere; guide cap 6000 tokens).
META_EFFORT_CLASSIFY=
META_EFFORT_EXTRACT=
META_EFFORT_OTHER=
META_EFFORT_COMPILE=
META_EFFORT_GUIDE=
META_MAX_TOKENS_GUIDE=
